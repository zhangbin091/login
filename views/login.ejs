<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><%= title %></title>
  <link rel="stylesheet" href="/vendor/element-ui/lib/theme-chalk/index.css">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <div class="page">
    <div class="page__bg"></div>

    <!-- Vue 2 挂载点，模板在 /js/modules/login.js -->
    <div id="app" v-cloak>
      <login-page></login-page>
    </div>

    <footer class="page__footer">© <%= year %> Login Flow Demo · Express + EJS + RequireJS + Vue2 + ElementUI</footer>
  </div>

  <!-- 供前端读取的非敏感配置 -->
  <script>
    window.__APP_CONFIG__ = <%- JSON.stringify(clientConfig) %>;
  </script>

  <!-- RequireJS：先定义配置，再加载入口 -->
  <script src="/js/require.config.js"></script>
  <script src="/vendor/requirejs/require.js" data-main="/js/main.js"></script>
</body>
</html>
